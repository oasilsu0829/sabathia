# ~/.openclaw/.env 로 복사해서 값을 채우세요. (chmod 600 권장, 절대 git에 올리지 마세요)

# Anthropic API 키 (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# @BotFather 에서 받은 텔레그램 봇 토큰
TELEGRAM_BOT_TOKEN=

# gog(구글 캘린더) — Gateway가 실행하는 알리미 스크립트에서 쓰입니다
GOG_ACCOUNT=you@gmail.com
GOG_KEYRING_BACKEND=file
GOG_KEYRING_PASSWORD=

# 조회할 캘린더 (기본 primary, 여러 개면 쉼표로, 전부면 all)
ALIMI_CALENDARS=primary
