// ~/.openclaw/openclaw.json 에 합쳐 넣을 알리미 설정 예시
// <...> 부분을 실제 값으로 바꾸세요. 비밀 값(봇 토큰, API 키)은 ~/.openclaw/.env 에 둡니다.
{
  agents: {
    defaults: {
      // 에이전트가 "3시"를 한국 시각으로 이해하도록
      userTimezone: "Asia/Seoul",
      envelopeTimezone: "Asia/Seoul",
      timeFormat: "24",
    },
  },

  channels: {
    telegram: {
      enabled: true,
      // 봇 토큰은 .env 의 TELEGRAM_BOT_TOKEN 으로 넣는다
      // 나만 쓰는 봇: 내 숫자 user ID만 허용
      dmPolicy: "allowlist",
      allowFrom: ["<TELEGRAM_USER_ID>"],
    },
  },

  commands: {
    ownerAllowFrom: ["telegram:<TELEGRAM_USER_ID>"],
  },

  cron: {
    enabled: true,
  },
}
